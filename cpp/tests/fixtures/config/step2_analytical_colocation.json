{
  "schema_version": 2,
  "run_id": "step2-analytical-colocation",
  "simulation_mode": "offline",
  "system_architecture": "co-location",
  "enable_parallel_clusters": false,
  "prefix_cache": {
    "enabled": false,
    "key_mode": "session"
  },
  "scheduler": {
    "type": "vllm_v1",
    "scheduling_policy": "fcfs",
    "batch_size_cap": 8,
    "max_tokens_in_batch": 128,
    "enable_preemption": false,
    "enable_chunked_prefill": false,
    "long_prefill_token_threshold": 0,
    "block_size": 16,
    "num_blocks": 128,
    "watermark_blocks_fraction": 0.0,
    "num_preallocate_tokens": 0
  },
  "execution_model": {
    "type": "analytical",
    "device": "rubin",
    "model": "llama2-7b",
    "precision": "fp16",
    "tensor_parallel_size": 8,
    "num_layers": 32,
    "network_bandwidth_gbps": 400.0,
    "network_latency_us": 1.0,
    "intra_node_bandwidth_gbps": 14400.0
  }
}
