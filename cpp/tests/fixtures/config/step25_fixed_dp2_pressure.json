{
  "schema_version": 3,
  "run_id": "step25-fixed-dp2-pressure",
  "simulation_mode": "offline",
  "system_architecture": "co-location",
  "enable_parallel_clusters": false,
  "parallelism": {
    "num_replicas": 1,
    "tensor_parallel_size": 2,
    "pipeline_parallel_size": 2,
    "data_parallel_size": 2
