{
  "schema_version": 2,
  "run_id": "kimi-k3-gb300-tep8-8k-prefill",
  "simulation_mode": "online",
  "system_architecture": "co-location",
  "prefix_cache": {
    "enabled": false,
    "key_mode": "session"
  },
  "cluster_scheduler": {
    "type": "round_robin"
  },
  "model": "moonshotai/Kimi-K3",
  "clusters": {
    "monolithic": {
      "profile": "gb300-tracelab-8gpu",
      "parallelism": {
        "num_replicas": 1,
        "tensor_parallel_size": 8,
        "decode_context_parallel_size": 1,
        "pipeline_parallel_size": 1,
        "data_parallel_size": 1,
        "moe_tensor_parallel_size": 1,
        "moe_expert_parallel_size": 8
      },
      "scheduler": {
        "type": "vllm_v1",
        "scheduling_policy": "fcfs",
        "batch_size_cap": 256,
        "max_tokens_in_batch": 131072,
        "enable_preemption": true,
        "enable_chunked_prefill": true,
        "long_prefill_token_threshold": 8192,
        "block_size": 16,
        "watermark_blocks_fraction": 0.0,
        "num_preallocate_tokens": 0
      },
      "execution_model": {
        "type": "analytical",
        "precision_profile": "kimi-k3-native",
        "kernel_profile": "k3_sglang_mxfp4",
        "moe_layer_event_mode": "stage_group_scaled"
      },
      "moe_routing": {
        "mode": "simulation",
        "distribution": "balanced",
        "seed": 42
      }
    }
  }
}
