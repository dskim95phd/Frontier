{
  "schema_version": 1,
  "run_id": "example-online-dense-analytical",
  "simulation_mode": "online",
  "system_architecture": "co-location",
  "enable_parallel_clusters": false,
  "prefix_cache": {"enabled": false, "key_mode": "session"},
  "cluster_scheduler": {"type": "round_robin"},
  "clusters": {
    "monolithic": {
      "parallelism": {
        "num_replicas": 1,
        "tensor_parallel_size": 4,
        "pipeline_parallel_size": 2,
        "data_parallel_size": 2,
        "moe_tensor_parallel_size": 1,
        "moe_expert_parallel_size": 1
      },
      "scheduler": {
        "type": "vllm_v1",
        "scheduling_policy": "fcfs",
        "batch_size_cap": 8,
        "max_tokens_in_batch": 128,
        "enable_preemption": true,
        "enable_chunked_prefill": true,
        "long_prefill_token_threshold": 0,
        "block_size": 16,
        "num_blocks": 2048,
        "watermark_blocks_fraction": 0.0,
        "num_preallocate_tokens": 0
      },
      "execution_model": {
        "type": "analytical",
        "device": "rubin",
        "precision": "fp16",
        "network_bandwidth_gbps": 400.0,
        "network_latency_us": 1.0,
        "intra_node_bandwidth_gbps": 14400.0
      },
      "model_name": "meta-llama/Llama-2-7b-hf",
      "moe_routing": {"mode": "simulation", "distribution": "balanced", "seed": 42}
    }
  }
}
